WITH max_claim AS (
    SELECT
        ndc,
        channel,
        MAX(claim_count) AS max_claim_count
    FROM pscdsapp.claim_quantity_history
    GROUP BY ndc, channel
),
highest_rows AS (
    SELECT q.*
    FROM pscdsapp.claim_quantity_history q
    JOIN max_claim m
      ON q.ndc = m.ndc
     AND q.channel = m.channel
     AND q.claim_count = m.max_claim_count
)
SELECT
    ndc,
    channel,
    claim_count,
    COUNT(*) AS repeat_count
FROM highest_rows
GROUP BY ndc, channel, claim_count
HAVING COUNT(*) > 1
ORDER BY repeat_count DESC, ndc, channel;
