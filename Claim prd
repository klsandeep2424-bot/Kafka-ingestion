@Override
public List<Invoice> filterReceivedInvoicesByAccountNumber(String bankAccountFilter, long bankAccountId) {

    String query =
            "SELECT i.* FROM invoice i " +
            "JOIN bank_account ba ON i.seller_id = ba.id AND i.buyer_id = ? " +
            "WHERE ba.account_number LIKE CONCAT('%', ?, '%')";

    return jdbcTemplate.query(query, Invoice::fromRow, bankAccountId, bankAccountFilter);
}
